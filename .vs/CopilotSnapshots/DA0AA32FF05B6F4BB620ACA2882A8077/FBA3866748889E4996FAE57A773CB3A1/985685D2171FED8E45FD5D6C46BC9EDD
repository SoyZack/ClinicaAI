using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using RestSharp;

public class GeminiIaService
{
    private readonly string _apiKey;
    private readonly string _model;
    private readonly ILogger<GeminiIaService> _logger;

    public GeminiIaService(IConfiguration configuration, ILogger<GeminiIaService> logger)
    {
        _apiKey = configuration["GeminiSettings:ApiKey"] ?? "";
        _model = configuration["GeminiSettings:Model"] ?? "gemini-2.5-flash";
        _logger = logger;
    }

    public async Task<string> ObtenerRespuestaTriajeAsync(string mensajePaciente)
    {
        if (string.IsNullOrWhiteSpace(_apiKey))
        {
            throw new GeminiIaException(null, "No se ha cargado GeminiSettings:ApiKey. Comprueba User Secrets y reinicia la aplicación.");
        }

        try
        {
            var url = $"https://generativelanguage.googleapis.com/v1beta/models/{_model}:generateContent";
            var client = new RestClient();
            var request = new RestRequest(url, Method.Post);
            request.AddHeader("Content-Type", "application/json");
            request.AddHeader("x-goog-api-key", _apiKey);

            // Configurar el System Prompt estricto y el mensaje del usuario
            var payload = new
            {
                system_instruction = new
                {
                    parts = new[]
                    {
                        new { text = "Eres el asistente virtual de triaje médico de CliniAI. Tu función es evaluar síntomas, clasificar la prioridad (Baja, Alta, Urgencia) y sugerir la especialidad adecuada. Si el paciente pregunta algo no relacionado con salud o medicina, niégate amablemente." }
                    }
                },
                contents = new[]
                {
                    new
                    {
                        parts = new[]
                        {
                            new { text = mensajePaciente }
                        }
                    }
                }
            };

            request.AddJsonBody(payload);

            var response = await client.ExecuteAsync(request);

            if (response.IsSuccessful && response.Content != null)
            {
                dynamic resultado = JsonConvert.DeserializeObject(response.Content)!;
                string textoRespuesta = resultado.candidates[0].content.parts[0].text;
                return textoRespuesta;
            }

            return "Lo siento, hubo un problema al procesar tu consulta con la IA. Intenta nuevamente.";
        }
        catch
        {
            return "No fue posible conectar con el servicio de IA. Intenta nuevamente más tarde.";
        }
    }
}