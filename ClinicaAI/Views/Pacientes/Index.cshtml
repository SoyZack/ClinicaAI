@model IReadOnlyList<ClinicaAI.Models.DB.Paciente>
@{
    ViewData["Title"] = "Pacientes";
}
<div class="page-heading"><div><p class="eyebrow">Gestión clínica</p><h1>Pacientes</h1><p>Directorio y datos de contacto de los pacientes.</p></div><a asp-action="Crear" class="btn btn-primary">+ Registrar paciente</a></div>
<section class="surface">
    <form method="get" class="filter-bar"><label for="buscar" class="visually-hidden">Buscar</label><input id="buscar" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por nombre u otros datos…" /><button class="btn btn-primary" type="submit">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></form>
    <p class="result-count">@Model.Count registro(s)</p>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>Sin registros para mostrar</h2><p>Prueba con otro filtro o registra el primer elemento.</p></div>
    }
    else
    {

        <div class="table-responsive">
            <table class="table align-middle">
                <caption class="visually-hidden">Pacientes</caption>
                <thead><tr><th scope="col">Paciente</th><th scope="col">Documento</th><th scope="col">Teléfono</th><th scope="col">Nacimiento</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr><td><strong>@item.Nombre @item.Apellido</strong><small class="d-block text-muted">#@item.IdPaciente · @(item.Email ?? "Sin correo vinculado")</small></td><td>@(item.DocumentoIdentidad ?? "—")</td><td>@item.Telefono</td><td>@(item.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</td><td class="actions"><a asp-action="Editar" asp-route-id="@item.IdPaciente" class="btn btn-sm btn-outline-primary">Editar</a><a asp-controller="Consultas" asp-action="Index" asp-route-idPaciente="@item.IdPaciente" class="btn btn-sm btn-outline-secondary">Historial</a></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>


