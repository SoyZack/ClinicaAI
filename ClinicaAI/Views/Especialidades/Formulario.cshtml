@model ClinicaAI.Models.ViewModels.EspecialidadForm
@{
    ViewData["Title"] = Model.IdEspecialidad == 0 ? "Registrar especialidad" : "Editar especialidad";
}
<div class="page-heading">
    <div><p class="eyebrow">Especialidades</p><h1>@ViewData["Title"]</h1><p>Completa la información y guarda los cambios.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>
<section class="surface form-surface">
    <form asp-action="Guardar" method="post">
        <input asp-for="IdEspecialidad" type="hidden" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" maxlength="100" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Descripcion"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="255"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Guardar especialidad</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
