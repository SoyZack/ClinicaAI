@model IReadOnlyList<ClinicaAI.Models.DB.Medico>
@{
    ViewData["Title"] = "Médicos";
}
<div class="page-heading"><div><p class="eyebrow">Gestión clínica</p><h1>Médicos</h1><p>Especialidades y disponibilidad del equipo médico.</p></div><div class="actions"><a asp-controller="Especialidades" asp-action="Index" class="btn btn-outline-secondary">Gestionar especialidades</a><a asp-action="Crear" class="btn btn-primary">+ Registrar médico</a></div></div>
<section class="surface">
    <form method="get" class="filter-bar"><label for="buscar" class="visually-hidden">Buscar</label><input id="buscar" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por nombre u otros datos…" /><button class="btn btn-primary" type="submit">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></form>
    <p class="result-count">@Model.Count registro(s)</p>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>Sin registros para mostrar</h2><p>Prueba con otro filtro o registra el primer elemento.</p></div>
    }
    else
    {

        <div class="table-responsive">
            <table class="table align-middle">
                <caption class="visually-hidden">Médicos</caption>
                <thead><tr><th scope="col">Médico</th><th scope="col">Especialidad</th><th scope="col">Contacto</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr><td><strong>@item.Nombre @item.Apellido</strong></td><td>@item.IdEspecialidadNavigation.Nombre</td><td>@(item.Email ?? "—")<small class="d-block text-muted">@(item.Telefono ?? "—")</small></td><td><span class="status">@(item.Estado ?? "Sin estado")</span></td><td><a asp-action="Editar" asp-route-id="@item.IdMedico" class="btn btn-sm btn-outline-primary">Editar</a></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
