@model IReadOnlyList<ClinicaAI.Models.DB.TriajesChatbot>
@{
    ViewData["Title"] = "Consultas";
}
<div class="page-heading"><div><p class="eyebrow">Gestión clínica</p><h1>Consultas</h1><p>Historial de triajes registrados por el chatbot.</p></div></div>
<section class="surface">
    <form method="get" class="filter-bar"><input type="hidden" name="idPaciente" value="@ViewData["IdPaciente"]" /><label for="buscar" class="visually-hidden">Buscar</label><input id="buscar" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por nombre u otros datos…" /><button class="btn btn-primary" type="submit">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></form>
    <p class="result-count">@Model.Count registro(s)</p>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>Sin registros para mostrar</h2><p>Prueba con otro filtro.</p></div>
    }
    else
    {

        <div class="table-responsive">
            <table class="table align-middle">
                <caption class="visually-hidden">Consultas</caption>
                <thead><tr><th scope="col">Fecha</th><th scope="col">Paciente</th><th scope="col">Síntomas</th><th scope="col">Prioridad</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr><td>@(item.FechaTriaje?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td><td>@(item.IdPacienteNavigation == null ? "Paciente no registrado" : item.IdPacienteNavigation.Nombre + " " + item.IdPacienteNavigation.Apellido)</td><td class="summary-cell">@item.SintomasReportados</td><td><span class="status">@(item.NivelPrioridad ?? "Sin clasificar")</span></td><td><a asp-action="Detalles" asp-route-id="@item.IdTriaje" class="btn btn-sm btn-outline-primary">Ver detalle</a></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
