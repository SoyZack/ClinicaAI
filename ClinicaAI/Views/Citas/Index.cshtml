@model IReadOnlyList<ClinicaAI.Models.DB.Cita>
@{
    ViewData["Title"] = "Citas";
}
<div class="page-heading"><div><p class="eyebrow">Gestión clínica</p><h1>Citas</h1><p>Agenda de atención de la clínica.</p></div><a asp-action="Crear" class="btn btn-primary">+ Registrar cita</a></div>
<section class="surface">
    <form method="get" class="filter-bar"><label for="fecha">Fecha</label><input type="date" id="fecha" name="fecha" value="@ViewData["Fecha"]" class="form-control" /><button class="btn btn-primary" type="submit">Filtrar</button><a asp-action="Index" class="btn btn-outline-secondary">Ver todas</a></form>
    <p class="result-count">@Model.Count registro(s)</p>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>Sin registros para mostrar</h2><p>Prueba con otro filtro o registra el primer elemento.</p></div>
    }
    else
    {

        <div class="table-responsive">
            <table class="table align-middle">
                <caption class="visually-hidden">Citas</caption>
                <thead><tr><th scope="col">Fecha y hora</th><th scope="col">Paciente</th><th scope="col">Médico</th><th scope="col">Motivo</th><th scope="col">Estado</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr><td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td><td>@item.IdPacienteNavigation.Nombre @item.IdPacienteNavigation.Apellido</td><td>@item.IdMedicoNavigation.Nombre @item.IdMedicoNavigation.Apellido</td><td>@(item.MotivoConsulta ?? "—")</td><td><span class="status">@item.Estado</span></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
